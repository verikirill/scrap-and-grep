{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# The API is a set of interchangeable replicas. Caddy resolves the compose
	# service name on every refresh, so `--scale api=N` needs no config change
	# and no access to the Docker socket. Active health checks do not work with
	# dynamic upstreams; a replica that refuses connections is skipped for
	# fail_duration and the request is retried on another one.
	handle /api/* {
		reverse_proxy {
			dynamic a {
				name api
				port 8000
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			# Server-Sent Events must reach the browser as they are written.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			# Inline styles are set by the animation library; scripts, fonts and
			# requests stay same-origin.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
			-Server
		}
		# Hashed build assets never change; the HTML shell must be revalidated.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
