<!--
  ClickHouse holds one table of reader events here, not a warehouse. These
  settings fit it into the container's memory cap (CLICKHOUSE_MEMORY, 1 GB by
  default) and keep it quiet on an idle stack.
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <!-- Caches sized for a table of millions of rows, not billions. -->
    <mark_cache_size>134217728</mark_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <max_concurrent_queries>32</max_concurrent_queries>

    <!-- The server's own logs of queries and metrics would soon outgrow the
         events themselves. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <blob_storage_log remove="1"/>
    <query_metric_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
