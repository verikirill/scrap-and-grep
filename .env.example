# Copy to .env and adjust. Every value has a working default, so the stack
# also starts without this file.

# --- Ports and scaling -------------------------------------------------------
WEB_PORT=8080
API_REPLICAS=2
INGEST_WORKERS=1
DIGEST_WORKERS=2
PROFILE_WORKERS=1

# --- Secrets -----------------------------------------------------------------
# Change before exposing the stack outside your machine.
POSTGRES_PASSWORD=radar

# --- Accounts ----------------------------------------------------------------
# "Войти без регистрации" creates a throwaway guest account with the example
# profiles; it is deleted after a day. Turn it off on a server open to the
# internet. The session cookie gets the Secure flag only when the stack is
# served over HTTPS.
RADAR_DEMO_LOGIN=true
RADAR_REGISTRATION_OPEN=true
RADAR_COOKIE_SECURE=false
# Administrators manage the source catalogue. The role is granted from the
# server, never by the address someone registers with:
#   docker compose exec api radar grant-admin you@example.org

# --- Resume parsing ------------------------------------------------------------
# Built in: PDF with a text layer, DOCX, TXT, Markdown. With docling (page
# layout, OCR of scans and photos, PPTX, ODT, HTML) start the stack with
#   --profile docling
# and uncomment the next line. The parser image takes about 4 GB on disk.
# RADAR_DOCPARSER_URL=http://docparser:8000
DOCPARSER_THREADS=4
DOCPARSER_MEMORY=3g

# --- AI providers ------------------------------------------------------------
# Offline stand-ins (default): no model server, instant, keyword-driven.
RADAR_EMBEDDING_PROVIDER=hashing
RADAR_LLM_PROVIDER=heuristic

# Real models through Ollama. Start with:
#   docker compose --profile ollama up -d
# and on an NVIDIA GPU add: -f docker-compose.yml -f docker-compose.gpu.yml
# RADAR_EMBEDDING_PROVIDER=ollama
# RADAR_LLM_PROVIDER=ollama
# embeddinggemma:300m gave the best candidate recall on our own data and fits
# next to the LLM on an 8-12 GB card. qwen3-embedding:4b ranks the top of the
# list better but needs 4.4 GB of VRAM on its own (docs/DECISIONS.md).
RADAR_EMBEDDING_MODEL=embeddinggemma:300m
RADAR_LLM_MODEL=qwen3.5:9b
RADAR_LLM_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=2

# An Ollama that already runs on the host instead of the bundled container:
# RADAR_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Short videos ------------------------------------------------------------
# A vertical video of a digest: script, voice, Remotion render. Start with
#   --profile video            the renderer and the media worker (silent videos
#                              with word-by-word captions)
#   --profile voice            Qwen3-TTS narration; on an NVIDIA GPU also add
#                              -f docker-compose.gpu.yml
# and uncomment the lines for the profiles you started.
# RADAR_SHORTS_URL=http://shorts:3000
# RADAR_TTS_URL=http://tts:8000
# Readers pick the voice when they order a video. The voices are listed in
# tts/voices/voices.json: anchor (default), presenter, blogger, analyst.
# TTS_SPEAKER sets the default one; RADAR_TTS_VOICE is used when a reader
# does not pick.
# TTS_SPEAKER=anchor
TTS_KEEP_ALIVE_SECONDS=600
# Every line is checked by Whisper and spoken again if it came out wrong;
# off turns the check off.
# TTS_CHECK_MODEL=off
# Cores and memory of the renderer. Browser tabs rendering frames in parallel:
# empty lets Remotion take half of SHORTS_CPUS; more than SHORTS_CPUS is refused.
SHORTS_CPUS=4
SHORTS_MEMORY=4g
# SHORTS_CONCURRENCY=2

# --- Ingestion ---------------------------------------------------------------
RADAR_INGEST_CRON=*/15 * * * *
RADAR_LOG_LEVEL=INFO
