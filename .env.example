# Copy to .env and adjust. Every value has a working default, so the stack
# also starts without this file.

# --- Ports and scaling -------------------------------------------------------
WEB_PORT=8080
API_REPLICAS=2
INGEST_WORKERS=1
DIGEST_WORKERS=2
PROFILE_WORKERS=1

# --- Secrets -----------------------------------------------------------------
# Change before exposing the stack outside your machine.
POSTGRES_PASSWORD=radar

# --- Accounts ----------------------------------------------------------------
# "Войти без регистрации" creates a throwaway guest account with the example
# profiles; it is deleted after a day. Turn it off on a server open to the
# internet. The session cookie gets the Secure flag only when the stack is
# served over HTTPS.
# RADAR_AUTH=off opens the app with no sign-in screen: every visitor becomes
# a guest of their own straight away, registering stays in the account menu.
# The stack starts that way; set it to on where accounts must be signed in.
RADAR_AUTH=off
# An open catalogue: every reader, guests too, adds sites and channels by any
# address, and may change and remove only what they added. false leaves the
# catalogue to administrators.
RADAR_OPEN_CATALOG=true
RADAR_DEMO_LOGIN=true
RADAR_REGISTRATION_OPEN=true
RADAR_COOKIE_SECURE=false
# Administrators manage the source catalogue. The role is granted from the
# server, never by the address someone registers with:
#   docker compose exec api radar grant-admin you@example.org

# --- Resume parsing ------------------------------------------------------------
# Built in: PDF with a text layer, DOCX, TXT, Markdown. With docling (page
# layout, OCR of scans and photos, PPTX, ODT, HTML) start the stack with
#   --profile docling
# and uncomment the next line. The parser image takes about 4 GB on disk.
# RADAR_DOCPARSER_URL=http://docparser:8000
DOCPARSER_THREADS=4
DOCPARSER_MEMORY=3g

# --- AI providers ------------------------------------------------------------
# Offline stand-ins (default): no model server, instant, keyword-driven.
RADAR_EMBEDDING_PROVIDER=hashing
RADAR_LLM_PROVIDER=heuristic

# Real models, all local: nothing leaves the stack. Grades and texts come
# from Qwen3.6 35B-A3B, a model of the finals, in the bundled Ollama: 22.6 GB,
# on a card of 12-16 GB the layers that do not fit run on the CPU. Embeddings
# come from the same Ollama. Start with:
#   docker compose --profile ollama up -d
# and on an NVIDIA GPU add: -f docker-compose.yml -f docker-compose.gpu.yml
# The first start pulls the models.
# RADAR_EMBEDDING_PROVIDER=ollama
# RADAR_LLM_PROVIDER=ollama
# embeddinggemma:300m gave the best candidate recall on our own data.
# qwen3-embedding:4b ranks the top of the list better but needs 4.4 GB of
# VRAM on its own (docs/DECISIONS.md).
RADAR_EMBEDDING_MODEL=embeddinggemma:300m
RADAR_LLM_MODEL=qwen3.6:35b-a3b
# Empty: the bundled Ollama, the one that makes the embeddings.
RADAR_LLM_BASE_URL=
# Qwen answers a schema as well without hidden reasoning.
RADAR_LLM_REASONING=off
# One GPU answers one request after another; 2 keeps it busy.
RADAR_LLM_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=2

# A weak card, from 8 GB: Qwen3.5 9B (6.6 GB). It is not in the finals' list
# and makes more mistakes in Russian (docs/DECISIONS.md).
# RADAR_LLM_MODEL=qwen3.5:9b

# An Ollama that already runs on the host instead of the bundled container:
# RADAR_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Any OpenAI-compatible Chat Completions server instead of Ollama: the same
# digest, the model changed in .env only. vLLM in the stack, a card of 24 GB
# and more (docker-compose.vllm.yml; the model and its memory are set there):
#   docker compose -f docker-compose.yml -f docker-compose.vllm.yml \
#     --profile ollama --profile vllm up -d
# RADAR_LLM_PROVIDER=openai
# RADAR_LLM_BASE_URL=http://vllm:8000/v1
# RADAR_LLM_MODEL=qwen3.6-35b-a3b
# vLLM batches requests on one card, unlike Ollama.
# RADAR_LLM_CONCURRENCY=8
# VLLM_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ
# VLLM_CPU_OFFLOAD_GB=2.5
# VLLM_MAX_MODEL_LEN=32768
# Another server of your own: RADAR_LLM_BASE_URL=http://host:8000/v1
# Yandex AI Studio, if the finals give Alice AI ART as an API inside the
# perimeter (asked, docs/FINAL_PLAN.md, Л9): the model URI from
# https://yandex.cloud/ru/docs/ai-studio/concepts/generation/models with your
# folder id, which is also the project.
# RADAR_LLM_PROVIDER=openai
# RADAR_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# RADAR_LLM_MODEL=gpt://<folder-id>/<model>/latest
# RADAR_LLM_PROJECT=<folder-id>
# RADAR_LLM_API_KEY=

# --- Short videos ------------------------------------------------------------
# A vertical video of a digest: script, voice, Remotion render. Start with
#   --profile video            the renderer and the media worker (silent videos
#                              with word-by-word captions)
#   --profile voice            Qwen3-TTS narration; on an NVIDIA GPU also add
#                              -f docker-compose.gpu.yml
# and uncomment the lines for the profiles you started.
# RADAR_SHORTS_URL=http://shorts:3000
# RADAR_TTS_URL=http://tts:8000
# Readers pick the voice when they order a video. The voices are listed in
# tts/voices/voices.json: anchor (default), presenter, blogger, analyst.
# TTS_SPEAKER sets the default one; RADAR_TTS_VOICE is used when a reader
# does not pick.
# TTS_SPEAKER=anchor
TTS_KEEP_ALIVE_SECONDS=600
# Every line is checked by Whisper and spoken again if it came out wrong;
# off turns the check off.
# TTS_CHECK_MODEL=off
# Cores and memory of the renderer. Browser tabs rendering frames in parallel:
# empty lets Remotion take half of SHORTS_CPUS; more than SHORTS_CPUS is refused.
SHORTS_CPUS=4
SHORTS_MEMORY=4g
# SHORTS_CONCURRENCY=2

# --- Telegram channels ---------------------------------------------------------
# Bots post news to the readers' channels on a schedule. Bot tokens are stored
# encrypted with a key derived from this secret; without it no bot can be
# added. Make it random and keep it: a new one makes the stored tokens
# unreadable.
#   openssl rand -base64 32
# RADAR_SECRET_KEY=
# To try everything without Telegram, start the stack with
#   --profile telegram-mock
# and send the bots to the mock Bot API instead. What they post is on
# http://localhost:8089.
# RADAR_TELEGRAM_API_URL=http://telegram-mock:8089

# --- MCP for AI assistants ------------------------------------------------------
# Readers make keys on the account page; an assistant calls /api/mcp/ with one.
# Calls a minute per reader:
RADAR_MCP_RATE_LIMIT_PER_MINUTE=60

# --- Article pictures ----------------------------------------------------------
# A picture is kept by its address; a copy is made only when Telegram cannot
# fetch it or a video needs it. Copies go to the media volume, or to any
# S3-compatible store: --profile s3 starts SeaweedFS for that.
# RADAR_IMAGE_STORE=s3
# RADAR_S3_ENDPOINT=s3:8333
# RADAR_S3_BUCKET=radar-images
# RADAR_S3_ACCESS_KEY=radar
# Change this one before the s3 profile runs anywhere but your machine.
# RADAR_S3_SECRET_KEY=change-me-s3-secret

# --- Reader events, analytics and the learned feed ranker ----------------------
# What readers were shown and what they did goes to ClickHouse, which runs in
# the stack. An empty value turns events off, and the analytics page and the
# learned ranker with them; everything else works as before.
# RADAR_CLICKHOUSE_URL=
# Change this one before the stack runs anywhere but your machine.
# CLICKHOUSE_PASSWORD=radar
# CLICKHOUSE_MEMORY=1g
# A model that beat the hand blend on the last days serves this share of
# readers, the rest stay on the hand blend for comparison; 0 keeps everyone
# on the hand blend.
# RADAR_RANKER_SHARE=0.5

# --- Ingestion ---------------------------------------------------------------
RADAR_INGEST_CRON=*/15 * * * *
# Public Telegram channels are read from their web preview, t.me/s/<name>,
# trying these addresses in turn. Where Telegram is blocked, put a mirror of
# t.me first (a reverse proxy on a server that can reach it).
# RADAR_TELEGRAM_PREVIEW_URLS=["https://t.me", "https://telegram.me"]
# bdu.fstec.ru and ptsecurity.com use certificates of the Russian national CA
# (backend/src/radar/ingest/certs). It is trusted for these hosts and their
# subdomains only; a bare zone like "ru" is refused:
# RADAR_RUSSIAN_CA_HOSTS=["bdu.fstec.ru", "bduasutp.fstec.ru", "bdu-ibasu.fstec.ru", "ptsecurity.com"]
# Proxies, http://, https:// or socks5://[user:password@]host:port. In a
# closed network this is the corporate proxy to the internet: every request
# to a source goes through it, the browser steps included.
# RADAR_HTTP_PROXY=http://proxy.corp.local:3128
# Or a pool, comma-separated, tried in turn when a site refuses every way of
# reading without one (403, 429, no answer): geo-blocks and rate limits. A
# source may also get a proxy of its own in its settings.
# RADAR_HTTP_PROXIES=socks5://user:password@1.2.3.4:1080,http://5.6.7.8:3128
# The headless browser (the browser service, on by default): Camoufox, a
# Firefox for pages drawn by script and JS challenges that stop curl_cffi
# with Chrome's TLS fingerprint. Empty turns the step off; the image takes
# about 3 GB, so then also run `docker compose up --scale browser=0`.
# RADAR_BROWSER_URL=http://browser:8000
# How many pages it opens at once, and how long one may take:
# BROWSER_TABS=2
# BROWSER_TIMEOUT_SECONDS=30
# FlareSolverr, Chrome that passes a JS challenge when the browser is
# refused too. Start the stack with
#   --profile solver
# and uncomment (the image takes about 1 GB):
# RADAR_FLARESOLVERR_URL=http://flaresolverr:8191
# Politeness: the least pause between two requests to one host, in seconds
# (plus up to half of it at random). A host that answers 429 or 503 with
# Retry-After is not asked before then; a source failing again and again
# is polled less often, up to once a day.
# RADAR_FETCH_HOST_INTERVAL_SECONDS=1
RADAR_LOG_LEVEL=INFO

# --- Development only: Ollama's cloud -------------------------------------------
# Forbidden in the finals: article texts, topics and resumes without contacts
# leave the stack. gpt-oss-120b in Ollama's cloud with a key from
# https://ollama.com/settings/keys; the start is refused without the key.
# RADAR_LLM_PROVIDER=ollama
# RADAR_LLM_MODEL=gpt-oss:120b
# RADAR_LLM_BASE_URL=https://ollama.com
# RADAR_LLM_API_KEY=
# gpt-oss always reasons before answering; "low" is enough for a grade.
# RADAR_LLM_REASONING=low
# The cloud answers requests in parallel.
# RADAR_LLM_CONCURRENCY=4
